# ===== 使用方式 =====
# 复制本文件为 .env.local（放在 edu-agent 项目根目录，与 backend/ frontend/ 同级）
# backend/config.py 会从该文件读取全部配置

# ── 数据库 PostgreSQL ──
# 注意：默认 5433，避免与本机已占用的 5432 冲突
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent
DB_PASSWORD=your_postgres_password

# ── Milvus 向量库 ──
# 默认 19531，避免与本机已占用的 19530 冲突
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ── 大模型（DeepSeek）──
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# ── 本地模型权重路径（需自行下载，见 README）──
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=./models/classifier/all-MiniLM-L6-v2
BGE_M3_MODEL_PATH=./models/embedding/bge-m3
FINETUNED_CLASSIFIER_PATH=./models/classifier/finetune

# ── JWT 认证（必填，否则无法启动）──
JWT_SECRET_KEY=please_generate_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── MCP Server 地址 ──
KB_MCP_SERVER_URL=http://localhost:8000/mcp/kb
WEB_SEARCH_MCP_URL=http://localhost:8000/mcp/web-search

# ── Web 搜索（留空则自动使用免费的 DuckDuckGo）──
TAVILY_API_KEY=

# ── 应用基础配置 ──
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default
